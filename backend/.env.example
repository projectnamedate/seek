# Server Configuration
PORT=3001
NODE_ENV=production  # 'development' only allowed when SOLANA_NETWORK != mainnet-beta

# Solana Configuration
# Mainnet RPC: https://api.mainnet-beta.solana.com (rate-limited) or Helius/QuickNode/Triton
# Devnet RPC:  https://api.devnet.solana.com
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_NETWORK=mainnet-beta

# COLD authority for local init/admin scripts. Mainnet launch should use Ledger.
# Do NOT put the cold Ledger/private key in Railway runtime env.
AUTHORITY_SIGNER=ledger
AUTHORITY_LEDGER_PATH=44'/501'/1'
AUTHORITY_LEDGER_PUBKEY=replace_with_cold_ledger_pubkey
# Mainnet default is true. Set false only for local rehearsal.
AUTHORITY_LEDGER_CONFIRM_PUBKEY=true
# Devnet/interim fallback only:
# AUTHORITY_SIGNER=keypair
# AUTHORITY_PRIVATE_KEY=your_local_admin_keypair_base58_here

# HOT authority: signs ONLY reveal_mission + propose_resolution. Backend-held.
# Compromise is contained (cannot drain treasury or rotate authority).
# REQUIRED on mainnet-beta.
HOT_AUTHORITY_PRIVATE_KEY=your_hot_base58_private_key_here

# Program IDs
SEEK_PROGRAM_ID=DqsCXFjgLp4UDZgMQE6nvEHe7yiRNJsVYFv21JSbd73v
# Mainnet SKR (official Solana Mobile token, 6 decimals)
# Devnet test mint (9 decimals): u3BkoKjVYYPt24Dto1VPwAzqeQg9ffaxnCVhTAYbAFF
SKR_MINT=SKRbvo6Gf7GondiT3BbTfuRDPqLWei4j2Qy2NPGZhW3

# Fees wallet — receives the 10% protocol-treasury cut from every loss.
# CRITICAL: this address is consumed ONCE by scripts/initialize-protocol.ts
# at initialize_singularity_vault. It is rotatable post-init via
# `admin.ts set-treasury <new_pubkey>` (cold-authority signed), but
# confirm carefully before running init on mainnet.
FEES_WALLET=Fmv8HqyQPUEp29wkybPimVkGbDverxs9BVji1rn2Y9Hr

# Anthropic (Claude API) - Get your key at https://console.anthropic.com
ANTHROPIC_API_KEY=replace_with_anthropic_api_key

# Validation Settings
MAX_PHOTO_AGE_SECONDS=300
MIN_CONFIDENCE_SCORE=0.7
MAX_BOUNTIES_PER_WALLET_PER_DAY=20
MAX_WINS_PER_IDENTITY_PER_DAY=2
# Public disputes are disabled in the current mainnet program; finalization is
# immediate and this must match the on-chain CHALLENGE_PERIOD.
CHALLENGE_PERIOD_SECONDS=0

# SGT verification (optional — lowers confidence threshold for Seeker owners)
HELIUS_API_KEY=
SGT_BONUS_CONFIDENCE_REDUCTION=0.05

# Emergency anti-abuse denylist. Comma- or newline-separated public addresses.
# The release also code-seeds the targeted kxk.skr incident-response block.
BLOCKED_PLAYER_WALLETS=
BLOCKED_SGT_MINTS=

# Wallet-signed bounty sessions. Enforce only after the v3 mobile build is live.
REQUIRE_BOUNTY_SESSION_PROOF=false
MIN_SESSION_CLIENT_PROTOCOL_VERSION=3
BOUNTY_SESSION_TTL_SECONDS=1800

# Sentry (optional — omit to disable error tracking)
SENTRY_DSN=

# Redis (optional during dev — REQUIRED on mainnet for state persistence + scale)
# Recommended: Upstash Redis (serverless, free tier covers launch volume).
REDIS_URL=
